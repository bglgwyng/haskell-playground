cabal-version: 3.12
name: haskell-playground
version: 0.1.0.0
license: MIT
license-file: LICENSE
author: bgl gwyng
maintainer: bgl@gwyng.com
category: Codec
build-type: Simple
extra-doc-files: CHANGELOG.md

common warnings
  ghc-options: -Wall

common languages
  default-language: GHC2024
  default-extensions:
    BlockArguments
    DerivingStrategies
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings

library
  import: warnings, languages
  exposed-modules: MyLib
  build-depends: base ^>=4.20.2.0
  hs-source-dirs: lib

executable playground
  import: warnings, languages
  main-is: playground.hs
  build-depends:
    base ^>=4.20.2.0,
    constraints,
    ghc,
    ghc-paths,
    haskeline,
    haskell-playground,
    hint,
    mtl,

  hs-source-dirs: exe

test-suite haskell-playground-test
  import: warnings, languages
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    base ^>=4.20.2.0,
    haskell-playground,
